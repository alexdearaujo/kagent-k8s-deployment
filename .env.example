# Proxmox API credentials
# Token format: user@realm!tokenid  (token_name is the ID after the !)
PROXMOX_USER="root@pam"
PROXMOX_TOKEN_NAME="your-token-id"
PROXMOX_TOKEN_SECRET="your-token-secret-uuid"

# Directory where talosctl will write generated configs and patches
# Keep the config-* prefix: .gitignore only protects config-*/ and these files
# contain an os:admin client certificate for the cluster
TALOS_CONFIG_DIR=./config-talos

# Kentik Company ID, found in Portal → top-right menu → Organization Settings
KENTIK_COMPANY_ID=your-company-id

# Kentik account credentials, used to auto-generate a provisioning token
# Get your API token from: Kentik Portal → Settings → API Tokens
K_API_EMAIL=your-email@company.com
K_API_TOKEN=your-kentik-api-token

# Optional: override default API root (grpc.api.kentik.com for US, grpc.api.kentik.eu for EU)
# K_API_ROOT=grpc.api.kentik.com

# Set this to skip token generation on subsequent runs (printed after first run)
# KENTIK_PROVISIONING_TOKEN=

# Optional: override default kagent config output directory
# Keep the config-* prefix: .gitignore only protects config-*/ and this
# directory holds the agent's private keys
# KAGENT_CONFIG_DIR=./config-kagent

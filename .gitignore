# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secret values: copy .env.example and fill in your credentials
.env

# Customer names and real hostnames fed to tools/privacy_scan.py. The whole
# point of this file is that its contents must never be committed.
.privacy-terms

# Live deployment configs: copy *.example and customise for your environment
talos.yaml
kagent.yaml

# Generated Config directories (talos + kagent)
config-*/

# Editor settings: share the project-level files, ignore everything VS Code
# drops in here per machine.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json


release_name: kagent
namespace: kentik
# Default replica count; override at runtime with --replicas N
replica_count: 1
# GitHub tarball used because the OCI registry (ghcr.io/kentik/kagent-helm) is not populated by upstream CI
helm_chart_ref: https://github.com/kentik/kagent-helm/archive/refs/heads/main.tar.gz
# Leave empty to use the cluster default storage class; set to a named class if needed (e.g. gp3, standard)
storage_class: ""
# Name for the auto-generated provisioning token; defaults to "kagent-<release_name>" if blank
token_name: ""
# Set to true to skip the manual Portal authorization step for the generated token
auto_approve: false

# Resource requests and limits per pod.
# Defaults are lab-sized; increase for production (KB recommends cpu: 1/2, memory: 1024Mi/4096Mi)
resources:
  requests:
    cpu: "250m"
    memory: "256Mi"
  limits:
    cpu: "1"
    memory: "512Mi"
